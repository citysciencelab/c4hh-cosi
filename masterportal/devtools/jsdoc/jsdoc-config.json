{
    "plugins": [
      "node_modules/jsdoc-vuejs",
      "plugins/markdown"
    ],
    "recurseDepth": 10,
    "source": {
        "include": ["./src"],
        "includePattern": "\\.(vue|js)$",
        "excludePattern": "(node_modules\\/)|((\\/|\\\\)__)|(.spec.js)"
    },
    "tags": {
        "allowUnknownTags": true,
        "dictionaries": ["jsdoc","closure"]
    },
    "linenums": true,
    "opts": {
      "encoding": "utf8",
      "recurse": true,
      "verbose": true,
      "destination": "./jsdoc",
      "template": "node_modules/docdash"
    },
    "templates": {
      "cleverLinks": false,
      "monospaceLinks": false,
      "search": true,
      "default": {
        "staticFiles": {
          "include": ["./devtools/jsdoc/styles", "./devtools/jsdoc/js", "./devtools/jsdoc/assets"]
        }
      }
    },
    "docdash": {
      "sort": true,
      "search": true,
      "collapse": true,
      "typedefs": true,
      "scripts": ["custom.css", "custom.js"],
      "sectionOrder": [
        "Modules",
        "Classes",
        "Global"
      ]
    }
    
}
